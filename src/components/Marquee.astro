---
// Cinta en movimiento con los atributos de la marca. La segunda pista es un duplicado decorativo.
import { SITE, TRUST_ITEMS } from '../data/site';

const items = [SITE.tagline, ...TRUST_ITEMS.map((item) => item.title)];
const TRACKS = [false, true] as const;
---

<div class="marquee border-y border-noche/15 bg-oro py-5 text-noche md:py-6">
  {
    TRACKS.map((isDuplicate) => (
      <ul class="marquee-track" aria-hidden={isDuplicate ? 'true' : undefined}>
        {items.map((item) => (
          <li class="flex items-center font-display text-2xl font-medium tracking-[-0.01em] whitespace-nowrap md:text-[2rem]">
            <span class="px-7 md:px-10">{item}</span>
            <svg viewBox="-1 -1 2 2" class="h-4 w-4 shrink-0" aria-hidden="true" focusable="false">
              <path
                d="M0 -1 Q0.16 -0.16 1 0 Q0.16 0.16 0 1 Q-0.16 0.16 -1 0 Q-0.16 -0.16 0 -1 Z"
                fill="currentColor"
              />
            </svg>
          </li>
        ))}
      </ul>
    ))
  }
</div>
