---
import { Picture } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import plantImage from '../assets/images/planta-silos.jpg';
import { PROCESS_STEPS } from '../data/site';
---

<section id="proceso" class="on-dark starfield relative isolate overflow-hidden bg-noche-profundo py-24 md:py-36">
  <div class="container-content">
    <SectionHeading eyebrow="Cómo trabajamos" title="Del origen a su empresa, en cuatro pasos" onDark />
  </div>

    <!-- Imagen ilustrativa generada por IA: sin leyenda, no afirma instalaciones propias. -->
  <!-- La imagen se expande hasta ocupar el ancho completo al hacer scroll. -->
  <div class="mt-12 px-3 md:mt-16 md:px-5">
    <div class="media aspect-[4/3] bg-noche md:aspect-[21/9]" data-expand data-parallax>
      <Picture
        src={plantImage}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1920, 2560]}
        sizes="100vw"
        alt="Silos de acero inoxidable, un camión cisterna y contenedores de aceite a granel en un patio de carga"
        loading="lazy"
      />
    </div>
  </div>

  <div class="container-content">
    <div class="relative mt-16 md:mt-24">
      <!-- Línea de progreso: vertical en móvil, horizontal en escritorio. Visible completa sin JS. -->
      <div
        class="absolute bottom-0 left-7 top-0 w-px bg-marfil/20 lg:bottom-auto lg:left-0 lg:right-0 lg:top-7 lg:h-px lg:w-auto"
        aria-hidden="true"
      >
        <div class="absolute inset-0 origin-top bg-oro lg:origin-left" data-progress-fill></div>
      </div>

      <ol class="relative grid gap-12 lg:grid-cols-4 lg:gap-10" data-reveal-group data-progress-steps>
        {
          PROCESS_STEPS.map((step, index) => (
            <li class="grid grid-cols-[3.5rem_1fr] gap-x-6 lg:block">
              <span
                class="flex h-14 w-14 items-center justify-center rounded-full border border-oro bg-noche-profundo font-display text-lg font-medium text-oro"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="lg:mt-8">
                <h3 class="text-2xl font-medium leading-tight tracking-[-0.01em] text-marfil md:text-[1.75rem]">
                  {step.title}
                </h3>
                <p class="mt-3 text-marfil/80">{step.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
