---
import { Picture } from 'astro:assets';
import Arrow from './Arrow.astro';
import heroImage from '../assets/images/campo-girasoles-agricultor.jpg';
import { QUOTE_ANCHOR } from '../data/site';

const SEAL_TEXT = 'Solicitar cotización · Aceite de girasol premium · ';
---

<section
  id="inicio"
  class="on-dark relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-noche-profundo"
>
  <!-- TODO: imagen generada por IA; reemplazar por fotografía real de la empresa cuando exista. -->
  <div class="absolute inset-0 -z-10 overflow-hidden lg:left-[26%]" data-hero-media>
    <Picture
      src={heroImage}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      alt="Agricultor en un campo de girasoles en flor al atardecer"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full origin-top object-cover object-[58%_top]"
      pictureAttributes={{ class: 'block h-full w-full' }}
    />
  </div>
  <!-- Velos que garantizan el contraste del texto y del header sobre la imagen -->
  <div
    class="absolute inset-0 -z-10 bg-linear-to-t from-noche-profundo from-30% via-noche-profundo/80 via-62% to-noche-profundo/20 lg:bg-linear-to-r lg:from-noche-profundo lg:from-26% lg:via-noche-profundo/65 lg:via-52% lg:to-noche-profundo/0"
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-x-0 top-0 -z-10 h-40 bg-linear-to-b from-noche-profundo/75 to-transparent" aria-hidden="true">
  </div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-[45%] bg-linear-to-t from-noche-profundo to-transparent" aria-hidden="true">
  </div>

  <div class="container-content relative pb-12 pt-36 md:pb-16 lg:pt-44">
    <div class="max-w-[62rem]" data-hero-copy>
      <p class="eyebrow flex items-center gap-4 text-oro">
        <span class="rule" aria-hidden="true" data-hero-rule></span>
        Importación directa · Distribución mayorista
      </p>
      <h1 class="display-hero mt-7 text-marfil" data-hero-title>
        Aceite de girasol <em class="accent">premium</em> para su empresa
      </h1>
      <div class="mt-9 grid gap-9 md:mt-12 md:grid-cols-[minmax(0,30rem)_auto] md:items-end md:gap-14">
        <p class="text-base text-marfil/90 md:text-lg">
          Orión importa y distribuye aceite de girasol al por mayor en Chile. Un proveedor especializado, con origen
          europeo y experiencia en comercio internacional.
        </p>
        <div class="flex flex-col gap-4 sm:flex-row">
          <a href={QUOTE_ANCHOR} class="btn btn-primary">Solicitar cotización <Arrow /></a>
          <a href="#producto" class="btn btn-light">Ver producto</a>
        </div>
      </div>
    </div>

    <!-- Indicador de scroll (decorativo) -->
    <div class="mt-14 hidden items-center gap-4 md:flex" aria-hidden="true" data-hero-cue>
      <span class="scroll-cue-line"></span>
      <span class="eyebrow text-marfil/70">Descubra Orión</span>
    </div>

    <!-- Sello giratorio (decorativo: el botón principal ya enlaza a la cotización) -->
    <div class="absolute bottom-14 right-10 hidden h-44 w-44 xl:block" aria-hidden="true" data-hero-seal>
      <svg viewBox="0 0 200 200" class="h-full w-full" focusable="false">
        <defs>
          <path id="seal-circle" d="M100 100 m-78 0 a78 78 0 1 1 156 0 a78 78 0 1 1 -156 0"></path>
        </defs>
        <circle cx="100" cy="100" r="99" fill="#0c1626" fill-opacity="0.55" stroke="#e8a917" stroke-opacity="0.5"></circle>
        <g class="seal-ring">
          <text fill="#faf6ec" font-size="12.5" font-weight="600" letter-spacing="2.6" style="text-transform: uppercase">
            <textPath href="#seal-circle" textLength="486">{SEAL_TEXT}</textPath>
          </text>
        </g>
      </svg>
      <img src="/isotipo-orion.svg" alt="" width="1349" height="1349" class="absolute inset-0 m-auto h-20 w-20" />
    </div>
  </div>
</section>
