---
// Isotipo de Orión: girasol con la constelación calada.
// Redibujado con brand/tools/gen-isotipo.cjs; el SVG vive en public/.
interface Props {
  class?: string;
  /** Texto alternativo. Si se omite, el isotipo es decorativo. */
  title?: string;
  /** Se conserva por compatibilidad: el isotipo es dorado en ambos fondos. */
  onDark?: boolean;
}

const { class: className, title } = Astro.props;
---

<img
  src="/isotipo-orion.svg"
  alt={title ?? ''}
  aria-hidden={title ? undefined : 'true'}
  width="1349"
  height="1349"
  decoding="async"
  loading="lazy"
  class={className}
  data-isotipo
/>
