---
// Logotipo de Orión (girasol con constelación + nombre caligráfico).
// Vectorizado desde brand/logo-orion-v2-fuente.png; los SVG viven en public/.
import { SITE } from '../data/site';

const LOGO_VARIANT = {
  POSITIVE: 'positive',
  NEGATIVE: 'negative',
} as const;

type LogoVariant = (typeof LOGO_VARIANT)[keyof typeof LOGO_VARIANT];

interface Props {
  variant?: LogoVariant;
  showTagline?: boolean;
}

const { variant = LOGO_VARIANT.POSITIVE, showTagline = false } = Astro.props;
const isNegative = variant === LOGO_VARIANT.NEGATIVE;
const src = isNegative ? '/logo-orion-negativo.svg' : '/logo-orion.svg';
---

<span class="inline-flex flex-col items-start">
  <img
    src={src}
    alt={SITE.name}
    width="3719"
    height="1343"
    decoding="async"
    class:list={['w-auto', showTagline ? 'h-16 md:h-20' : 'h-12 md:h-14']}
  />
  {
    showTagline && (
      <span
        class:list={[
          'mt-3 text-[0.625rem] font-medium uppercase tracking-[0.22em]',
          isNegative ? 'text-oro' : 'text-bronce',
        ]}
      >
        {SITE.tagline}
      </span>
    )
  }
</span>
