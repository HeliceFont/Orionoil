---
import Isotype from './Isotype.astro';
import { SITE } from '../data/site';

const LOGO_VARIANT = {
  POSITIVE: 'positive',
  NEGATIVE: 'negative',
} as const;

type LogoVariant = (typeof LOGO_VARIANT)[keyof typeof LOGO_VARIANT];

interface Props {
  variant?: LogoVariant;
  showTagline?: boolean;
}

const { variant = LOGO_VARIANT.POSITIVE, showTagline = false } = Astro.props;
const isNegative = variant === LOGO_VARIANT.NEGATIVE;
---

<span class="inline-flex items-center gap-3">
  <Isotype class="h-11 w-11 shrink-0 md:h-12 md:w-12" onDark={isNegative} />
  <span class="flex flex-col leading-none">
    <span
      class:list={[
        'font-display text-2xl font-semibold tracking-[0.14em] md:text-[1.75rem]',
        isNegative ? 'text-marfil' : 'text-noche',
      ]}
    >
      ORIÓN
    </span>
    {
      showTagline && (
        <span
          class:list={[
            'mt-1.5 text-[0.625rem] font-medium uppercase tracking-[0.22em]',
            isNegative ? 'text-oro' : 'text-bronce',
          ]}
        >
          {SITE.tagline}
        </span>
      )
    }
  </span>
</span>
